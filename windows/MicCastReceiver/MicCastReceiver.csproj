<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MicCastReceiver</AssemblyName>
    <RootNamespace>MicCastReceiver</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <!-- 自绘控件不参与设计器序列化，关掉 WinForms 的 WFO1000 分析器规则 -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- 界面左上角的品牌标记复用手机端同一份透明底素材，保证两端一致 -->
    <EmbeddedResource Include="..\..\entry\src\main\resources\base\media\brand_mark.png"
                      LogicalName="MicCastReceiver.brand_mark.png" />
    <!-- 窗体/托盘图标：显式加载，避免沿用 Windows 图标缓存里的旧版本 -->
    <EmbeddedResource Include="app.ico" LogicalName="MicCastReceiver.app.ico" />
  </ItemGroup>

</Project>
