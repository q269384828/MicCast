<Window
    x:Class="MicCastReceiver.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MicCastReceiver.WinUI">

    <Grid x:Name="RootGrid" Background="{ThemeResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 自绘标题栏（WinUI 3 的能力，WinForms 版只能改 DWM 配色）===== -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel
                Orientation="Horizontal"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Spacing="8">
                <Image Source="ms-appx:///Assets/brand_mark.png" Width="16" Height="16" />
                <TextBlock
                    Text="MicCast — 手机麦克风接收端"
                    FontSize="{StaticResource FontLabel}"
                    Foreground="{ThemeResource TextMutedBrush}"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Padding="20,0,20,20"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Disabled">
            <!--
                外面套一层撑满的 Grid，里面用 MaxWidth 限宽并居中。
                不能直接给 StackPanel 设 MaxWidth + HorizontalAlignment=Center ——
                那样会按「内容自然宽度」测量，反而把卡片缩窄。
            -->
            <Grid>
                <StackPanel Spacing="12" MaxWidth="860" HorizontalAlignment="Center">

                <!-- ===== Hero：品牌 + 状态 + 电平 + 指标 ===== -->
                <Border
                    CornerRadius="{StaticResource RadiusHero}"
                    Padding="{StaticResource CardPadding}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="{ThemeResource HeroFromColor}" />
                            <GradientStop Offset="1" Color="{ThemeResource HeroToColor}" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <StackPanel Spacing="12">
                        <!-- 品牌行 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Image
                                Source="ms-appx:///Assets/brand_mark.png"
                                Width="{StaticResource IconSize}"
                                Height="{StaticResource IconSize}"
                                VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Margin="8,0,8,0" Spacing="1" VerticalAlignment="Center">
                                <TextBlock
                                    Text="MicCast"
                                    FontSize="{StaticResource FontHero}"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource OnHeroBrush}" />
                                <TextBlock
                                    Text="声渡 · 把手机麦克风变成一个 Windows 麦克风"
                                    FontSize="{StaticResource FontCaption}"
                                    Foreground="{ThemeResource OnHeroSoftBrush}" />
                            </StackPanel>

                            <Border
                                Grid.Column="2"
                                Style="{StaticResource PillStyle}"
                                Background="{ThemeResource HeroPillBgBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse
                                        x:Name="StatusDot"
                                        Width="6"
                                        Height="6"
                                        Fill="{ThemeResource OnHeroBrush}"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        x:Name="StatusText"
                                        Text="未启动"
                                        FontSize="{StaticResource FontLabel}"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource OnHeroBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 未连接时的提示 -->
                        <TextBlock
                            x:Name="HintText"
                            TextWrapping="Wrap"
                            FontSize="{StaticResource FontCaption}"
                            Foreground="{ThemeResource OnHeroSoftBrush}" />

                        <!-- 串流中：电平 + 指标 -->
                        <StackPanel x:Name="StreamingBlock" Spacing="8" Visibility="Collapsed">
                            <Grid>
                                <TextBlock
                                    Text="麦克风输入"
                                    FontSize="{StaticResource FontCaption}"
                                    Foreground="{ThemeResource OnHeroSoftBrush}" />
                                <TextBlock
                                    x:Name="LevelLabel"
                                    Text="无输入"
                                    FontSize="{StaticResource FontCaption}"
                                    Foreground="{ThemeResource OnHeroSoftBrush}"
                                    HorizontalAlignment="Right" />
                            </Grid>

                            <Grid Height="{StaticResource LevelBarHeight}">
                                <Border
                                    Background="{ThemeResource HeroTrackBrush}"
                                    CornerRadius="3" />
                                <Border
                                    x:Name="LevelFill"
                                    Background="{ThemeResource OnHeroBrush}"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"
                                    RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="LevelScale" ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>

                            <Border Height="1" Background="#33FFFFFF" Margin="0,2,0,2" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="1">
                                    <TextBlock x:Name="FpsValue" Text="0" Style="{StaticResource MetricTextStyle}" />
                                    <TextBlock Text="帧/秒" Style="{StaticResource MetricCaptionStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock x:Name="KbpsValue" Text="0" Style="{StaticResource MetricTextStyle}" />
                                    <TextBlock Text="kbps" Style="{StaticResource MetricCaptionStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="1">
                                    <TextBlock x:Name="BufValue" Text="0" Style="{StaticResource MetricTextStyle}" />
                                    <TextBlock Text="毫秒缓冲" Style="{StaticResource MetricCaptionStyle}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock
                                x:Name="ServerLine"
                                FontSize="{StaticResource FontCaption}"
                                Foreground="{ThemeResource OnHeroSoftBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== 虚拟声卡引导（缺 VB-CABLE 时才显示）===== -->
                <Border x:Name="Banner" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="还需要一个虚拟声卡"
                            FontSize="{StaticResource FontTitle}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextBrush}" />
                        <TextBlock
                            Text="Windows 没有内置虚拟麦克风。装好 VB-CABLE 后会出现 CABLE Input / CABLE Output 两个设备。"
                            TextWrapping="Wrap"
                            FontSize="{StaticResource FontCaption}"
                            Foreground="{ThemeResource TextMutedBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="InstallButton"
                                Content="自动下载并安装"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="32"
                                FontSize="{StaticResource FontLabel}"
                                Click="OnInstallVbCable" />
                            <Button
                                Content="打开下载页面"
                                Style="{StaticResource OutlineButtonStyle}"
                                Height="32"
                                FontSize="{StaticResource FontLabel}"
                                Click="OnOpenVbCablePage" />
                            <Button
                                Content="我已装好，刷新"
                                Style="{StaticResource OutlineButtonStyle}"
                                Height="32"
                                FontSize="{StaticResource FontLabel}"
                                Click="OnRecheckVbCable" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== 主操作 + 增益 ===== -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="StartButton"
                        Grid.Column="0"
                        Content="开始接收"
                        Width="150"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnToggleReceiving" />

                    <TextBlock
                        x:Name="GainLabel"
                        Grid.Column="2"
                        Text="增益 0 dB"
                        Style="{StaticResource SettingLabelStyle}"
                        TextAlignment="Right"
                        Width="88"
                        Margin="0,0,10,0" />

                    <Slider
                        x:Name="GainSlider"
                        Grid.Column="3"
                        Width="280"
                        Minimum="-12"
                        Maximum="12"
                        StepFrequency="1"
                        VerticalAlignment="Center"
                        ValueChanged="OnGainChanged" />
                </Grid>

                <!-- ===== 设备设置（图标 + 标题 + 右侧控件）===== -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE717;" Style="{StaticResource SettingIconStyle}" />
                            <TextBlock Grid.Column="1" Text="手机" Style="{StaticResource SettingLabelStyle}"
                                       Width="{StaticResource SettingLabelWidth}" Margin="8,0,0,0" />
                            <ComboBox x:Name="ServerBox" Grid.Column="2" HorizontalAlignment="Stretch"
                                      Height="{StaticResource ControlHeight}"
                                      PlaceholderText="正在扫描局域网…"
                                      SelectionChanged="OnServerSelected" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE767;" Style="{StaticResource SettingIconStyle}" />
                            <TextBlock Grid.Column="1" Text="输出设备" Style="{StaticResource SettingLabelStyle}"
                                       Width="{StaticResource SettingLabelWidth}" Margin="8,0,0,0" />
                            <ComboBox x:Name="DeviceBox" Grid.Column="2" HorizontalAlignment="Stretch"
                                      Height="{StaticResource ControlHeight}"
                                      SelectionChanged="OnDeviceSelected" />
                            <Button Grid.Column="3" Content="刷新" Style="{StaticResource OutlineButtonStyle}"
                                    Height="{StaticResource ControlHeight}" FontSize="{StaticResource FontLabel}"
                                    Margin="8,0,0,0" Click="OnRefreshDevices" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE70F;" Style="{StaticResource SettingIconStyle}" />
                            <TextBlock Grid.Column="1" Text="或手动 IP" Style="{StaticResource SettingLabelStyle}"
                                       Width="{StaticResource SettingLabelWidth}" Margin="8,0,0,0" />
                            <TextBox x:Name="IpBox" Grid.Column="2" Width="230"
                                     Height="{StaticResource ControlHeight}"
                                     PlaceholderText="192.168.x.x"
                                     VerticalContentAlignment="Center" />
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- ===== 日志 ===== -->
                <Border Style="{StaticResource CardStyle}" Background="{ThemeResource SurfaceBrush}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock
                                Text="日志"
                                FontSize="{StaticResource FontTitle}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextBrush}"
                                VerticalAlignment="Center" />
                            <Button
                                Content="清空"
                                Style="{StaticResource GhostButtonStyle}"
                                HorizontalAlignment="Right"
                                Click="OnClearLog" />
                        </Grid>
                        <Border
                            Background="{ThemeResource LogBgBrush}"
                            CornerRadius="{StaticResource RadiusControl}"
                            Padding="10">
                            <ScrollViewer x:Name="LogScroll" Height="240" VerticalScrollBarVisibility="Auto">
                                <TextBlock
                                    x:Name="LogText"
                                    FontFamily="Consolas"
                                    FontSize="{StaticResource FontCaption}"
                                    Foreground="{ThemeResource LogTextBrush}"
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>