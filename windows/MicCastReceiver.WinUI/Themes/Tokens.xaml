<!--
    设计 token —— 数值与 docs/design-system.md 一一对应，也和手机端
    harmony/entry/src/main/resources/{base,dark}/element/color.json 对齐。
    改视觉只改这里。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="BgBrush" Color="#F3F5FA" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F1F5FB" />
            <SolidColorBrush x:Key="BorderBrush" Color="#E4E9F2" />
            <SolidColorBrush x:Key="TrackBrush" Color="#E3E9F4" />
            <SolidColorBrush x:Key="TextBrush" Color="#16233A" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#5A6B85" />
            <SolidColorBrush x:Key="TextFaintBrush" Color="#8A9BAB" />
            <SolidColorBrush x:Key="AccentBrush" Color="#2F6BFF" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#1F5BF0" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#1A4FD0" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="OkBrush" Color="#12A150" />
            <SolidColorBrush x:Key="WarnBrush" Color="#B86E00" />
            <SolidColorBrush x:Key="DangerBrush" Color="#C42B2B" />
            <SolidColorBrush x:Key="DangerHoverBrush" Color="#D63C3C" />
            <SolidColorBrush x:Key="LogBgBrush" Color="#F7F9FD" />
            <SolidColorBrush x:Key="LogTextBrush" Color="#5A6B85" />
            <SolidColorBrush x:Key="PillIdleBgBrush" Color="#EDF1F8" />
            <SolidColorBrush x:Key="PillIdleFgBrush" Color="#5A6B85" />
            <SolidColorBrush x:Key="HoverOverlayBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="PressOverlayBrush" Color="#1A000000" />

            <Color x:Key="HeroFromColor">#2F6BFF</Color>
            <Color x:Key="HeroToColor">#12A594</Color>
            <SolidColorBrush x:Key="OnHeroBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="OnHeroSoftBrush" Color="#DCFFFFFF" />
            <SolidColorBrush x:Key="HeroTrackBrush" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="HeroPillBgBrush" Color="#33FFFFFF" />

            <!-- 覆盖 WinUI 原生控件用到的强调色，让 Slider / ComboBox / TextBox
                 跟随我们的 accent，而不是用户的系统强调色（可能是橄榄绿/橙色） -->
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#2F6BFF" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#1F5BF0" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#1A4FD0" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="#2F6BFF" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#2F6BFF" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#8A9BAB" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="BgBrush" Color="#0B1220" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#16203A" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1B2742" />
            <SolidColorBrush x:Key="BorderBrush" Color="#26314D" />
            <SolidColorBrush x:Key="TrackBrush" Color="#223052" />
            <SolidColorBrush x:Key="TextBrush" Color="#E6EDF7" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#8A9BB8" />
            <SolidColorBrush x:Key="TextFaintBrush" Color="#64748B" />
            <SolidColorBrush x:Key="AccentBrush" Color="#4F8CFF" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#6E9DFF" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#3D7AEE" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="OkBrush" Color="#3DDC97" />
            <SolidColorBrush x:Key="WarnBrush" Color="#FFB454" />
            <SolidColorBrush x:Key="DangerBrush" Color="#E05C5C" />
            <SolidColorBrush x:Key="DangerHoverBrush" Color="#E87575" />
            <SolidColorBrush x:Key="LogBgBrush" Color="#101A2E" />
            <SolidColorBrush x:Key="LogTextBrush" Color="#9FB2CC" />
            <SolidColorBrush x:Key="PillIdleBgBrush" Color="#2A3550" />
            <SolidColorBrush x:Key="PillIdleFgBrush" Color="#8A9BB8" />
            <SolidColorBrush x:Key="HoverOverlayBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="PressOverlayBrush" Color="#26FFFFFF" />

            <Color x:Key="HeroFromColor">#3E6FE6</Color>
            <Color x:Key="HeroToColor">#1F9E8C</Color>
            <SolidColorBrush x:Key="OnHeroBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="OnHeroSoftBrush" Color="#D9FFFFFF" />
            <SolidColorBrush x:Key="HeroTrackBrush" Color="#3DFFFFFF" />
            <SolidColorBrush x:Key="HeroPillBgBrush" Color="#33FFFFFF" />

            <!-- 覆盖 WinUI 原生控件用到的强调色，让 Slider / ComboBox / TextBox
                 跟随我们的 accent，而不是用户的系统强调色（可能是橄榄绿/橙色） -->
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#4F8CFF" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#6E9DFF" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#3D7AEE" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#16203A" />
            <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="#4F8CFF" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#4F8CFF" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#64748B" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="BgBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TrackBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextFaintBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="OkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="WarnBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DangerHoverBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LogBgBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LogTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="PillIdleBgBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="PillIdleFgBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HoverOverlayBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="PressOverlayBrush" Color="#26FFFFFF" />

            <Color x:Key="HeroFromColor">{ThemeResource SystemColorHighlightColor}</Color>
            <Color x:Key="HeroToColor">{ThemeResource SystemColorHighlightColor}</Color>
            <SolidColorBrush x:Key="OnHeroBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="OnHeroSoftBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="HeroTrackBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="HeroPillBgBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />

            <SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!--
        覆盖 WinUI 原生控件用到的系统资源键。
        不覆盖的话，Slider / ComboBox / TextBox 的强调色会跟随系统
        （用户系统强调色可能是橄榄绿、橙色…），和我们的 design-system 对不上。

        这些是 Fluent 的「lightweight styling」键，改它们不需要重写控件模板。
    -->



    <!-- ===== 圆角 ===== -->
    <CornerRadius x:Key="RadiusHero">22</CornerRadius>
    <CornerRadius x:Key="RadiusCard">16</CornerRadius>
    <CornerRadius x:Key="RadiusControl">10</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>

    <!-- ===== 间距（4 的倍数）===== -->
    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space5">20</x:Double>
    <x:Double x:Key="Space6">24</x:Double>
    <x:Double x:Key="Space8">32</x:Double>
    <Thickness x:Key="PagePadding">20</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <x:Double x:Key="CardGap">12</x:Double>

    <!-- ===== 字号 ===== -->
    <x:Double x:Key="FontHero">22</x:Double>
    <x:Double x:Key="FontMetric">20</x:Double>
    <x:Double x:Key="FontTitle">13</x:Double>
    <x:Double x:Key="FontButton">15</x:Double>
    <x:Double x:Key="FontBody">13</x:Double>
    <x:Double x:Key="FontLabel">12</x:Double>
    <x:Double x:Key="FontCaption">11</x:Double>

    <!-- ===== 控件尺寸 ===== -->
    <x:Double x:Key="ButtonHeight">44</x:Double>
    <x:Double x:Key="ControlHeight">38</x:Double>
    <x:Double x:Key="IconSize">34</x:Double>
    <x:Double x:Key="SettingIconSize">16</x:Double>
    <x:Double x:Key="SettingLabelWidth">82</x:Double>
    <x:Double x:Key="LevelBarHeight">6</x:Double>

</ResourceDictionary>
