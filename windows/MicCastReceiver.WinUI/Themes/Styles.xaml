<!--
    组件样式。所有颜色/圆角/间距都引用 Tokens.xaml，不写魔法数字。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MicCastReceiver.WinUI.Controls">

    <!--
        通用按钮模板：hover / press 用半透明叠加层实现，
        这样一个模板能适配主色、中性、危险三种底色，不用各写一份。
    -->
    <ControlTemplate x:Key="MicCastButtonTemplate" TargetType="Button">
        <Grid
            x:Name="Root"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}">
            <Grid
                x:Name="HoverLayer"
                Background="Transparent"
                CornerRadius="{TemplateBinding CornerRadius}" />
            <Grid
                x:Name="PressLayer"
                Background="Transparent"
                CornerRadius="{TemplateBinding CornerRadius}" />
            <ContentPresenter
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                ContentTransitions="{TemplateBinding ContentTransitions}"
                FontFamily="{TemplateBinding FontFamily}"
                FontSize="{TemplateBinding FontSize}"
                FontWeight="{TemplateBinding FontWeight}"
                Foreground="{TemplateBinding Foreground}"
                Padding="{TemplateBinding Padding}" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames
                                Storyboard.TargetName="HoverLayer"
                                Storyboard.TargetProperty="Background">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource HoverOverlayBrush}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames
                                Storyboard.TargetName="PressLayer"
                                Storyboard.TargetProperty="Background">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource PressOverlayBrush}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="Root"
                                Storyboard.TargetProperty="Opacity"
                                To="0.5"
                                Duration="0" />
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <!-- 主操作：主色填充 -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource MicCastButtonTemplate}" />
        <Setter Property="Height" Value="{StaticResource ButtonHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontButton}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OnAccentBrush}" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- 次要操作：描边中性（停止接收用这个，红色只留给破坏性操作） -->
    <Style x:Key="OutlineButtonStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource MicCastButtonTemplate}" />
        <Setter Property="Height" Value="{StaticResource ButtonHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontButton}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Background" Value="{ThemeResource SurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18,0" />
    </Style>

    <!-- 轻量操作：无底，只有 hover 反馈 -->
    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource MicCastButtonTemplate}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="{StaticResource FontLabel}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <!-- 卡片：底 surface + 1px 描边 + 圆角 -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <!--
        状态胶囊（ContentControl）。

        两个易错点都在模板里一次性解决，使用点不用再操心：
        1. CornerRadius 不能写 999 —— WinUI 的 Border 不钳制半径，四段圆弧会
           重叠成纺锤形。这里固定高度 26 + 半径 13（= 半高）。
        2. 内容必须垂直居中 —— 光靠外层 Border 的 Padding 不够，
           子元素会撑满高度然后在顶部对齐（"接收中" 看起来偏上就是这个原因）。
           模板里 ContentPresenter 加了 VerticalAlignment=Center，结构上保证居中。
    -->
    <Style x:Key="PillStyle" TargetType="ContentControl">
        <Setter Property="Height" Value="26" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{ThemeResource PillIdleBgBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border
                        Background="{TemplateBinding Background}"
                        CornerRadius="13"
                        Padding="12,0">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 文字层级 -->
    <Style x:Key="MetricTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontMetric}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource OnHeroBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <!-- 数字等宽：数值跳动时整行不会左右呼吸 -->
    </Style>

    <Style x:Key="MetricCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource OnHeroSoftBrush}" />
    </Style>

    <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontLabel}" />
        <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingIconStyle" TargetType="FontIcon">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>


    <!--
        ===== 设置行 / 设置组 =====
        SettingRow：图标 + 标题 + 右侧控件，列宽与垂直居中都由模板保证。
        SettingGroup：卡片 + 分组标题，把语义上属于同一件事的行框在一起。
        使用点只声明 Glyph / Label / Header，不再手写 Grid 和 Margin。
    -->

    <Style TargetType="controls:SettingRow">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingRow">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Glyph="{TemplateBinding Glyph}"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="16"
                            Foreground="{ThemeResource TextMutedBrush}"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Column="1"
                            Text="{TemplateBinding Label}"
                            FontSize="{StaticResource FontLabel}"
                            Foreground="{ThemeResource TextMutedBrush}"
                            Width="{StaticResource SettingLabelWidth}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />

                        <ContentPresenter
                            Grid.Column="2"
                            Content="{TemplateBinding Content}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:SettingGroup">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingGroup">
                    <Border
                        Background="{ThemeResource SurfaceBrush}"
                        BorderBrush="{ThemeResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusCard}"
                        Padding="{StaticResource CardPadding}">
                        <StackPanel Spacing="14">
                            <TextBlock
                                Text="{TemplateBinding Header}"
                                Visibility="{TemplateBinding HeaderVisibility}"
                                FontSize="{StaticResource FontTitle}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextBrush}" />
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>