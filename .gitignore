# ===== DevEco Studio / hvigor（HarmonyOS 工程在 harmony/ 下） =====
/harmony/.hvigor/
/harmony/build/
/harmony/entry/build/
/harmony/oh_modules/
/harmony/entry/oh_modules/
/harmony/oh-package-lock.json5
/harmony/local.properties
# hvigor-wrapper.js 由 hvigorw 首次运行时自动生成
/harmony/hvigor/hvigor-wrapper.js
/harmony/hvigor/hvigor-wrapper.js.sha256

# 构建日志与临时文件
build*.log
/tools/*.log
/windows/*.log

# 签名材料（千万不要入库）
**/*.p7b
**/*.cer
**/*.p12
**/*.keystore
**/*.jks

# 含签名密码的本地构建配置；入库的 build-profile.json5 必须是模板
/harmony/build-profile.local.json5

# Windows 接收端构建产物
/windows/**/bin/
/windows/**/obj/
/windows/**/last-ip.txt

# 发布目录与安装包
/dist/

# VB-CABLE 驱动包属第三方软件，由程序运行时按需下载，不入库
/windows/vbcable/

# 调试产物
*.wav

# 系统
.DS_Store
Thumbs.db

# 根目录构建缓存
/.hvigor/

# 无线调试地址（环境相关，不入库）
/.hdc-connect.local
